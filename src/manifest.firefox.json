{
  "manifest_version": 3,
  "name": "Draw Over",
  "version": "1.0.0",
  "description": "Draw boxes, arrows and notes on top of any web page. Cover burned-in subtitles, annotate, and drag or resize your shapes on the fly.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Draw Over \u2014 toggle overlay (Alt+Shift+D)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Turn the drawing overlay on or off"
    },
    "toggle-passthrough": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Toggle click-through (use the page without losing your drawings)"
    },
    "toggle-edit": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Switch between edit mode and the drawing tool"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "draw-over@draw-over.local",
      "strict_min_version": "128.0"
    }
  }
}
